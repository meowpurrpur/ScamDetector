{
  "name": "ScamDetector",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run --reporter verbose",
    "dev": "tsx watch src/index.ts",
    "register-commands": "tsx src/lib/registerCommands.ts",
    "hash:gen": "tsx scripts/generateHashes.ts",
    "datasets:package": "tsx scripts/packageDatasets.ts",
    "datasets:download": "tsx scripts/downloadDatasets.ts",
    "datasets:normalise": "tsx scripts/normaliseDatasets.ts"
  },
  "keywords": [],
  "type": "commonjs",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.2.0",
    "@types/node-fetch": "^2.6.13",
    "@types/tar-fs": "^2.0.4",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "better-sqlite3@12.11.1": true
  },
  "dependencies": {
    "@theo/jsx-runtime": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "consola": "^3.4.2",
    "discord-api-types": "^0.38.53",
    "dotenv": "^17.4.2",
    "image-hash": "^7.0.1",
    "node-fetch": "^3.3.2",
    "oceanic.js": "^1.15.0",
    "sharp": "^0.35.3",
    "tar-fs": "^3.1.3",
    "tesseract.js": "^7.0.0"
  }
}
